<!-- Pending decision queue. Every row is read from Patch 7's authoritative model;
     nothing here is parsed or cached by the window. -->
<Listbox item="NMSLootPendingList">
  <ScreenID>NMSLootPendingList</ScreenID>
  <DrawTemplate>WDT_Inner</DrawTemplate>
  <RelativePosition>true</RelativePosition>
  <AutoStretch>false</AutoStretch>
  <Location><X>8</X><Y>40</Y></Location>
  <Size><CX>456</CX><CY>176</CY></Size>
  <Style_Border>true</Style_Border>
  <Style_VScroll>true</Style_VScroll>
  <Style_AutoVScroll>true</Style_AutoVScroll>
  <Columns>
    <Width>0</Width>
    <Heading></Heading>
  </Columns>
  <Columns>
    <Width>456</Width>
    <Heading>Pending loot</Heading>
  </Columns>
</Listbox>

<!-- Looter roster: the only legitimate Pass recipients. Replaced wholesale on
     every 0x140D, capped at 20 by Patch 7 and the server. -->
<Listbox item="NMSLootRosterList">
  <ScreenID>NMSLootRosterList</ScreenID>
  <DrawTemplate>WDT_Inner</DrawTemplate>
  <RelativePosition>true</RelativePosition>
  <AutoStretch>false</AutoStretch>
  <Location><X>8</X><Y>244</Y></Location>
  <Size><CX>456</CX><CY>88</CY></Size>
  <Style_Border>true</Style_Border>
  <Style_VScroll>true</Style_VScroll>
  <Style_AutoVScroll>true</Style_AutoVScroll>
  <Columns>
    <Width>0</Width>
    <Heading></Heading>
  </Columns>
  <Columns>
    <Width>456</Width>
    <Heading>Pass to (roster)</Heading>
  </Columns>
</Listbox>

<!-- Fixed text: this client exposes no runtime label or button text setter, so the
     page-style header cannot be rewritten. Every row carries its own numbers. -->
<Button item="NMSLootHeader">
  <ScreenID>NMSLootHeader</ScreenID>
  <Font>4</Font>
  <RelativePosition>true</RelativePosition>
  <Location><X>8</X><Y>8</Y></Location>
  <Size><CX>456</CX><CY>32</CY></Size>
  <Style_Checkbox>false</Style_Checkbox>
  <Text>Pending Loot Decision</Text>
  <TextColor><R>255</R><G>218</G><B>96</B></TextColor>
  <ButtonDrawTemplate>
    <Normal>A_NMSLootBtnNormal</Normal>
    <Pressed>A_NMSLootBtnPressed</Pressed>
    <Flyby>A_NMSLootBtnHover</Flyby>
