<!-- Top-level vault rows. Content is filled entirely from the Patch 7 model at
     runtime; the width-0 leading column is the standard trick this fork already
     uses in NMS_WaypointsWnd.xml to get a clean header gutter. -->
<Listbox item="NMSVaultItemList">
  <ScreenID>NMSVaultItemList</ScreenID>
  <DrawTemplate>WDT_Inner</DrawTemplate>
  <RelativePosition>true</RelativePosition>
  <AutoStretch>false</AutoStretch>
  <Location><X>8</X><Y>40</Y></Location>
  <Size><CX>400</CX><CY>200</CY></Size>
  <Style_Border>true</Style_Border>
  <Style_VScroll>true</Style_VScroll>
  <Style_AutoVScroll>true</Style_AutoVScroll>
  <Columns>
    <Width>0</Width>
    <Heading></Heading>
  </Columns>
  <Columns>
    <Width>400</Width>
    <Heading>Vault slot</Heading>
  </Columns>
</Listbox>

<!-- Selected container contents. Populated from the model bag_items only. -->
<Listbox item="NMSVaultContentsList">
  <ScreenID>NMSVaultContentsList</ScreenID>
  <DrawTemplate>WDT_Inner</DrawTemplate>
  <RelativePosition>true</RelativePosition>
  <AutoStretch>false</AutoStretch>
  <Location><X>8</X><Y>268</Y></Location>
  <Size><CX>400</CX><CY>88</CY></Size>
  <Style_Border>true</Style_Border>
  <Style_VScroll>true</Style_VScroll>
  <Style_AutoVScroll>true</Style_AutoVScroll>
  <Columns>
    <Width>0</Width>
    <Heading></Heading>
  </Columns>
  <Columns>
    <Width>400</Width>
    <Heading>Container</Heading>
  </Columns>
</Listbox>

<!-- Page indicator. Its text is fixed at load time because this client exposes no
     runtime label/button text setter; the authoritative current page is printed
     to chat and every row is prefixed with its global slot number. -->
<Button item="NMSVaultPageIndicator">
  <ScreenID>NMSVaultPageIndicator</ScreenID>
  <Font>4</Font>
  <RelativePosition>true</RelativePosition>
  <Location><X>8</X><Y>8</Y></Location>
  <Size><CX>400</CX><CY>32</CY></Size>
  <Style_Checkbox>false</Style_Checkbox>
  <Text>Dimensional Pocket Vault - pages 1-9, slots 1-83</Text>
  <TextColor><R>255</R><G>218</G><B>96</B></TextColor>
  <ButtonDrawTemplate>
    <Normal>A_NMSVaultBtnNormal</Normal>
    <Pressed>A_NMSVaultBtnPressed</Pressed>
    <Flyby>A_NMSVaultBtnHover</Flyby>
