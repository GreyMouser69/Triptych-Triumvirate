<!-- Deposit Item. Sits in the band deliberately left empty under the action row
     for exactly this control. It delegates to the server-side authoritative
     routine (#vault_autodeposit -> plugin::VaultAutoDeposit); the client chooses
     no destination and touches no vault state. Greyed, not hidden, while the
     cursor is empty - see NmsVaultWnd::UpdateDepositButtonState. -->
<Button item="NMSVaultDeposit">
  <ScreenID>NMSVaultDeposit</ScreenID>
  <Font>4</Font>
  <RelativePosition>true</RelativePosition>
  <Location><X>8</X><Y>420</Y></Location>
  <Size><CX>216</CX><CY>32</CY></Size>
  <Style_Checkbox>false</Style_Checkbox>
