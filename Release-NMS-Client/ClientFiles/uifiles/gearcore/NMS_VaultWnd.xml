<?xml version="1.0" encoding="us-ascii"?>
<XML ID="EQInterfaceDefinitionLanguage">
  <Schema xmlns="EverQuestData" xmlns:dt="EverQuestDataTypes" />

<!-- Shared button animations, same EQLS_window_pieces_01.tga slices the waypoint
     window uses. Naming and offsets follow NMS_WaypointsWnd.xml so the custom
     windows look identical; a wrong slice here renders a blank button, so they are
     copied verbatim rather than guessed. Only the header bar uses these now:
     every other button uses a standard BDT_* template, which is the layout the
     working NMS_LootWnd.xml established. A ButtonDrawTemplate bound to a
     hand-sliced 40x32 region is what made the old page row look cramped. -->
<Ui2DAnimation item = "A_NMSVaultBtnNormal">
  <Cycle>true</Cycle>
  <Frames>
    <Texture>EQLS_window_pieces_01.tga</Texture>
    <Location><X>0</X><Y>34</Y></Location>
    <Size><CX>244</CX><CY>32</CY></Size>
    <Hotspot><X>0</X><Y>0</Y></Hotspot>
    <Duration>1000</Duration>
  </Frames>
</Ui2DAnimation>
<Ui2DAnimation item = "A_NMSVaultBtnHover">
  <Cycle>true</Cycle>
  <Frames>
    <Texture>EQLS_window_pieces_01.tga</Texture>
    <Location><X>0</X><Y>65</Y></Location>
    <Size><CX>244</CX><CY>32</CY></Size>
    <Hotspot><X>0</X><Y>0</Y></Hotspot>
    <Duration>1000</Duration>
  </Frames>
</Ui2DAnimation>
<Ui2DAnimation item = "A_NMSVaultBtnPressed">
  <Cycle>true</Cycle>
  <Frames>
    <Texture>EQLS_window_pieces_01.tga</Texture>
    <Location><X>0</X><Y>96</Y></Location>
    <Size><CX>244</CX><CY>32</CY></Size>
    <Hotspot><X>0</X><Y>0</Y></Hotspot>
    <Duration>1000</Duration>
  </Frames>
</Ui2DAnimation>
<Ui2DAnimation item = "A_NMSVaultBtnPressedHover">
  <Cycle>true</Cycle>
  <Frames>
    <Texture>EQLS_window_pieces_01.tga</Texture>
    <Location><X>0</X><Y>158</Y></Location>
    <Size><CX>244</CX><CY>32</CY></Size>
    <Hotspot><X>0</X><Y>0</Y></Hotspot>
    <Duration>1000</Duration>
  </Frames>
</Ui2DAnimation>

<!-- MAIN Vault list: one row per global slot of the displayed page (pages 1-6
     show 10 slots, page 9 shows 3). Filled entirely from the Patch 7 model at
     runtime by NmsVaultWnd::Refresh(); the window never invents a row.
     Single column. The old width-0 gutter column is gone, exactly as in the
     working Loot window, because a zero-width leading column shifts every row. -->
<Listbox item="NMSVaultItemList">
  <ScreenID>NMSVaultItemList</ScreenID>
  <DrawTemplate>WDT_Inner</DrawTemplate>
  <RelativePosition>true</RelativePosition>
  <AutoStretch>false</AutoStretch>
  <Location><X>8</X><Y>44</Y></Location>
  <Size><CX>464</CX><CY>200</CY></Size>
  <Style_Border>true</Style_Border>
  <Style_VScroll>true</Style_VScroll>
  <Style_AutoVScroll>true</Style_AutoVScroll>
  <Columns>
    <Width>464</Width>
    <Heading>Vault slots</Heading>
  </Columns>
</Listbox>

<!-- CONTAINER CONTENTS list: shows what is inside the container currently
     selected in the main list, from NmsVaultWnd::RefreshContents(). This is a
     functional requirement, not decoration; it is how a player inspects a bag
     stored in the Vault without opening it. Single column, as above. -->
<Listbox item="NMSVaultContentsList">
  <ScreenID>NMSVaultContentsList</ScreenID>
  <DrawTemplate>WDT_Inner</DrawTemplate>
  <RelativePosition>true</RelativePosition>
  <AutoStretch>false</AutoStretch>
  <Location><X>8</X><Y>252</Y></Location>
  <Size><CX>464</CX><CY>88</CY></Size>
  <Style_Border>true</Style_Border>
  <Style_VScroll>true</Style_VScroll>
  <Style_AutoVScroll>true</Style_AutoVScroll>
  <Columns>
    <Width>464</Width>
    <Heading>Selected container contents</Heading>
  </Columns>
</Listbox>

<!-- Fixed header bar. This client exposes no runtime label or button text
     setter, so the page indicator cannot be rewritten: the current page is
     reported in chat by SetStatus() and every row carries its own slot number. -->
<Button item="NMSVaultPageIndicator">
  <ScreenID>NMSVaultPageIndicator</ScreenID>
  <Font>4</Font>
  <RelativePosition>true</RelativePosition>
  <Location><X>8</X><Y>8</Y></Location>
  <Size><CX>464</CX><CY>32</CY></Size>
  <Style_Checkbox>false</Style_Checkbox>
  <Text>Vault - pages 1-6 general, 7-8 clicky, 9 proc locker</Text>
  <TextColor><R>255</R><G>218</G><B>96</B></TextColor>
  <ButtonDrawTemplate>
    <Normal>A_NMSVaultBtnNormal</Normal>
    <Pressed>A_NMSVaultBtnPressed</Pressed>
    <Flyby>A_NMSVaultBtnHover</Flyby>
    <PressedFlyby>A_NMSVaultBtnPressedHover</PressedFlyby>
  </ButtonDrawTemplate>
</Button>

